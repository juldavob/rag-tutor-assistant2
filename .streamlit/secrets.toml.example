# Copia este archivo como .streamlit/secrets.toml para ejecutar en local con st.secrets
# (el archivo secrets.toml real está en .gitignore y NUNCA debe subirse a GitHub).
# En Streamlit Community Cloud pega este mismo contenido en: App -> Settings -> Secrets
GEMINI_API_KEY = "pega-aqui-tu-api-key"
# Opcional: fija el modelo exacto (recomendado para resultados reproducibles)
# GEMINI_MODEL = "nombre-exacto-del-modelo-en-AI-Studio"
